#!/usr/bin/env bash
# The secret scan shared by the pre-commit and pre-push hooks (not a hook itself: git runs only
# files named after a hook). It runs gitleaks with .gitleaks.toml through Docker, or a local
# gitleaks on the PATH, over what the hook names:
#
#   scan-secrets <hook> <gitleaks git flags...>
#
# Exit 0 clean, 3 a secret found (printed above, redacted), 1 nothing could be scanned (said why).
# It fails closed: the repository is public, CI scans only after a push, and GitHub's push
# protection does not know every key format (Google AI Studio's AQ. keys among them), so these
# hooks are the check before a key is published. LEDGERPAY_SKIP_SECRET_SCAN=1 skips it on
# purpose, for one command, when you know what is in the change.
set -euo pipefail

hook=$1
shift
IMAGE=ghcr.io/gitleaks/gitleaks:v8.30.1   # keep in step with .github/workflows/ci.yml
repo=$(git rev-parse --show-toplevel)
# In a worktree, .git is a file pointing into the main repository's .git directory. Both are mounted
# at their own absolute paths, so git in the container can follow it: with only the worktree
# mounted, gitleaks could not read the index, logged an error, exited 0, and nothing was scanned.
common=$(cd "$repo" && cd "$(git rev-parse --git-common-dir)" && pwd)

if [[ ${LEDGERPAY_SKIP_SECRET_SCAN:-} == 1 ]]; then
  echo "$hook: secret scan SKIPPED (LEDGERPAY_SKIP_SECRET_SCAN=1)." >&2
  exit 0
fi

if docker info > /dev/null 2>&1; then
  scanner=docker
elif command -v gitleaks > /dev/null 2>&1; then
  scanner=local
else
  echo "$hook: Docker is not running and gitleaks is not installed, so nothing can be scanned for" >&2
  echo "        secrets. Refused: start Docker, or install gitleaks, or, knowing what is in the" >&2
  echo "        change, rerun with LEDGERPAY_SKIP_SECRET_SCAN=1." >&2
  exit 1
fi

# A finding exits 3; any other failure (no image, no network, an unreadable repository, a range
# git cannot resolve) is the scan's own, reported as such: a scan that did not run is not a clean
# one. In Docker the repository is read-only, as the current user, so git inside trusts it.
args=(git "$@" --config "$repo/.gitleaks.toml" --redact --verbose --no-banner --log-level warn
  --exit-code 3 "$repo")
status=0
if [[ $scanner == docker ]]; then
  docker run --rm --user "$(id -u):$(id -g)" -v "$repo:$repo:ro" -v "$common:$common:ro" \
    -w "$repo" "$IMAGE" "${args[@]}" || status=$?
else
  gitleaks "${args[@]}" || status=$?
fi
case $status in
  0 | 3) exit "$status" ;;
  *)
    echo "$hook: the secret scan itself failed (exit $status), so nothing was checked." >&2
    echo "        Refused; fix the scan (is the image pullable?) and try again." >&2
    exit 1
    ;;
esac
