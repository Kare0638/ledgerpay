<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ledgerpay</groupId>
        <artifactId>ledgerpay</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>acceptance-tests</artifactId>
    <name>LedgerPay :: Acceptance Tests</name>
    <description>Acceptance tests across services: payment-service in-process, mock-psp as its own process (design §12)</description>

    <dependencies>
        <dependency>
            <groupId>com.ledgerpay</groupId>
            <artifactId>payment-service</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.ledgerpay</groupId>
            <artifactId>mock-psp</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
            <!-- Only its test helpers: mock-psp itself runs from its own jar, in its own JVM. -->
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- mock-psp's runnable jar, started by the tests as a separate process. Two Boot apps
                 cannot share a classpath: their application.yml and db/migration would collide. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-mock-psp</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.ledgerpay</groupId>
                                    <artifactId>mock-psp</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>exec</classifier>
                                    <destFileName>mock-psp.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}/apps</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
